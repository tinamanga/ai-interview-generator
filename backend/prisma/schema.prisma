
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Experience level selected when generating interview questions.
enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
}

// Defines the type of interview questions requested.
enum InterviewType {
  TECHNICAL
  BEHAVIORAL
  MIXED
}

// Tracks the lifecycle of a generation request.
enum GenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// Difficulty assigned to each generated question.
enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model Generation {
  id               String           @id @default(uuid()) @db.Uuid
  jobTitle         String           @db.VarChar(150)
  jobDescription   String           @db.Text
  experienceLevel  ExperienceLevel
  interviewType    InterviewType
  questionCount    Int
  provider         String           @default("gemini") @db.VarChar(50)
  model            String           @db.VarChar(100)
  promptVersion    String           @default("v1") @db.VarChar(20)
  status           GenerationStatus @default(PENDING)
  errorCode        String?          @db.VarChar(100)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?        @db.Timestamptz(3)

  // One generation can produce multiple interview questions.
  questions        GeneratedQuestion[]

  // Each generation can have at most one usage record.
  usage            UsageRecord?

  @@index([createdAt])
  @@index([status])
  @@map("generations")
}

model GeneratedQuestion {
  id                  String             @id @default(uuid()) @db.Uuid
  generationId        String             @db.Uuid
  position            Int
  question            String             @db.Text
  category            String             @db.VarChar(100)
  difficulty          QuestionDifficulty
  evaluationCriteria  String             @db.Text
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)

  // Deleting a generation also deletes its associated questions.
  generation          Generation         @relation(fields: [generationId], references: [id], onDelete: Cascade)

  // A generation cannot have two questions at the same position.
  @@unique([generationId, position])
  @@index([generationId])
  @@map("generated_questions")
}

model UsageRecord {
  id                String      @id @default(uuid()) @db.Uuid
  generationId      String      @unique @db.Uuid
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  latencyMs         Int
  providerRequestId String?     @db.VarChar(255)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)

  // Each usage record belongs to exactly one generation.
  generation        Generation  @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("usage_records")
}
